{
  "testing_context": {
    "version": "2.0",
    "application": "FlavorWheel México",
    "description": "Comprehensive E2E testing strategy for mobile-first flavor analysis platform",
    "last_updated": "2025-09-11T00:00:00Z",
    "architecture": {
      "framework": "Next.js 14",
      "ui_library": "React 18 + TypeScript",
      "styling": "Tailwind CSS + Radix UI",
      "database": "Supabase",
      "testing_stack": "Vitest + Playwright + Testing Library",
      "deployment": "Vercel/Netlify",
      "mobile_focus": true
    }
  },
  "test_categories": {
    "unit_tests": {
      "framework": "Vitest",
      "location": "__tests__/unit/",
      "coverage_target": "80%",
      "focus": "Pure functions, utilities, business logic",
      "examples": [
        "flavor-utils.ts",
        "navigation-config.ts",
        "smart-defaults.ts",
        "keyword-extraction-service.ts"
      ]
    },
    "component_tests": {
      "framework": "Vitest + React Testing Library",
      "location": "__tests__/component/",
      "coverage_target": "85%",
      "focus": "UI components, interactions, accessibility",
      "examples": [
        "simplified-tasting-flow.test.tsx",
        "mobile-navigation.tsx",
        "flavor-wheel.tsx",
        "ui/button.tsx"
      ]
    },
    "integration_tests": {
      "framework": "Vitest + Supertest",
      "location": "__tests__/integration/",
      "coverage_target": "75%",
      "focus": "API endpoints, database operations, service interactions",
      "examples": [
        "analytics-service.ts",
        "create-tasting-service.ts",
        "social-service.ts",
        "supabase-client.ts"
      ]
    },
    "e2e_tests": {
      "framework": "Playwright",
      "location": "__tests__/e2e/",
      "coverage_target": "90%",
      "focus": "Complete user journeys, cross-browser compatibility",
      "browsers": ["chromium", "firefox", "webkit", "mobile-chrome", "mobile-safari"],
      "examples": [
        "nav-visibility.spec.ts",
        "a11y-axe.spec.ts",
        "critical-user-journeys.spec.ts",
        "tasting-flow.spec.ts"
      ]
    },
    "visual_regression": {
      "framework": "Playwright + custom screenshots",
      "location": "__tests__/visual/",
      "focus": "UI consistency, responsive design, design system compliance",
      "threshold": "0.01%",
      "examples": [
        "mobile-navigation-layout",
        "flavor-wheel-interactions",
        "responsive-breakpoints"
      ]
    },
    "performance_tests": {
      "framework": "Lighthouse CI + Playwright",
      "location": "__tests__/performance/",
      "metrics": {
        "lcp": "< 2.5s",
        "fid": "< 100ms",
        "cls": "< 0.1",
        "fcp": "< 1.8s"
      },
      "focus": "Core Web Vitals, bundle size, runtime performance"
    },
    "accessibility_tests": {
      "framework": "axe-core/playwright",
      "location": "__tests__/e2e/a11y-axe.spec.ts",
      "standards": ["WCAG 2.1 AA", "WCAG 2.2"],
      "focus": "Keyboard navigation, screen reader support, color contrast",
      "automated_checks": [
        "color-contrast",
        "focus-order-semantics",
        "keyboard-accessible",
        "aria-valid"
      ]
    },
    "security_tests": {
      "framework": "OWASP ZAP + custom scripts",
      "location": "__tests__/security/",
      "focus": "XSS prevention, CSRF protection, input validation",
      "examples": [
        "auth-service-security",
        "input-sanitization",
        "api-rate-limiting"
      ]
    }
  },
