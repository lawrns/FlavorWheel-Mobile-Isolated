  "page_architecture_analysis": {
    "app_shell_usage": {
      "uses_app_shell": [
        "/analytics", "/profile", "/review", "/create", "/social",
        "/create-wheel", "/dashboard", "/competition/*", "/study/*",
        "/tastings/*", "/settings", "/flavor-wheels"
      ],
      "no_app_shell": [
        "/landing", "/login", "/register", "/home"
      ],
      "mixed_usage": [
        "/quick-tasting" // Uses UnifiedDashboard directly
      ]
    },
    "navigation_expectations": {
      "mobile_nav_visible": [
        "/home", "/quick-tasting", "/create", "/profile", "/analytics",
        "/social", "/flavor-wheels", "/competition/*", "/study/*", "/tastings/*"
      ],
      "mobile_nav_hidden": [
        "/landing", "/login", "/register"
      ],
      "desktop_nav_visible": "all authenticated pages"
    },
    "critical_elements": {
      "always_present": [
        "data-testid=\"app-ready\"",
        "skip-to-content links",
        "error boundaries"
      ],
      "page_specific": {
        "/landing": ["data-testid=\"quick-taste-button\"", "data-testid=\"create-tasting-button\""],
        "/home": ["mobile-navigation-root", "dashboard-content"],
        "/quick-tasting": ["simplified-tasting-flow", "flavor-selector"]
      }
    }
