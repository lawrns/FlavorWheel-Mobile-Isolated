# FlavorWheel México - Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# REQUIRED VARIABLES
# ============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URLs
NEXT_PUBLIC_APP_URL=https://yourapp.com
NEXTAUTH_URL=https://yourapp.com

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/flavorwheel

# Authentication
NEXTAUTH_SECRET=your-random-secret-key-here

# ============================================================================
# OPTIONAL VARIABLES
# ============================================================================

# Environment
NODE_ENV=development

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Core Features
NEXT_PUBLIC_ENABLE_SOCIAL_FEATURES=true
NEXT_PUBLIC_ENABLE_COMPETITIONS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ACHIEVEMENTS=true
NEXT_PUBLIC_ENABLE_CHALLENGES=true

# Advanced Features
NEXT_PUBLIC_ENABLE_VOICE_NOTES=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_REAL_TIME=true

# Experimental Features
NEXT_PUBLIC_ENABLE_AI_RECOMMENDATIONS=false
NEXT_PUBLIC_ENABLE_AR_FEATURES=false
NEXT_PUBLIC_ENABLE_BLOCKCHAIN_VERIFICATION=false

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# Payment Processing (Future)
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@domain.com

# Maps and Location
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# External APIs
NOM_VERIFICATION_API_KEY=your-nom-api-key
WEATHER_API_KEY=your-weather-api-key

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Logging
LOG_LEVEL=info
ENABLE_QUERY_LOGGING=false

# Development Tools
ENABLE_REACT_DEVTOOLS=true
ENABLE_REDUX_DEVTOOLS=true
ENABLE_PERFORMANCE_MONITORING=false

# Testing
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/flavorwheel_test
ENABLE_TEST_DATA=false

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# Security
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100
ENABLE_CORS_PROTECTION=true
ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# Performance
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
ENABLE_COMPRESSION=true
ENABLE_CDN=true

# Monitoring
SENTRY_DSN=your-sentry-dsn
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_TRACKING=true

# Backup
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
ENABLE_AUTOMATED_BACKUPS=true

# ============================================================================
# MOBILE APP SPECIFIC
# ============================================================================

# App Store Configuration
IOS_APP_ID=your-ios-app-id
ANDROID_PACKAGE_NAME=com.yourcompany.flavorwheel

# Deep Linking
DEEP_LINK_SCHEME=flavorwheel
UNIVERSAL_LINK_DOMAIN=yourapp.com

# Offline Storage
OFFLINE_STORAGE_LIMIT_MB=100
ENABLE_BACKGROUND_SYNC=true

# Device Features
ENABLE_CAMERA_INTEGRATION=true
ENABLE_LOCATION_SERVICES=true
ENABLE_BIOMETRIC_AUTH=true

# ============================================================================
# LOCALIZATION
# ============================================================================

# Default Language
DEFAULT_LANGUAGE=es-MX
SUPPORTED_LANGUAGES=es-MX,en-US

# Translation Services
TRANSLATION_API_KEY=your-translation-api-key
ENABLE_AUTO_TRANSLATION=false

# ============================================================================
# BUSINESS CONFIGURATION
# ============================================================================

# Mexican Beverage Regulations
CRT_API_ENDPOINT=https://api.crt.org.mx
CRM_API_ENDPOINT=https://api.crm.org.mx
ENABLE_NOM_VERIFICATION=true

# Regional Settings
DEFAULT_REGION=Mexico
DEFAULT_CURRENCY=MXN
DEFAULT_TIMEZONE=America/Mexico_City

# Content Moderation
ENABLE_CONTENT_MODERATION=true
MODERATION_API_KEY=your-moderation-api-key
AUTO_MODERATE_REVIEWS=true

# ============================================================================
# ADVANCED FEATURES
# ============================================================================

# AI and Machine Learning
OPENAI_API_KEY=your-openai-api-key
ENABLE_AI_FLAVOR_EXTRACTION=false
ENABLE_SMART_RECOMMENDATIONS=false

# Blockchain (Future)
ETHEREUM_RPC_URL=your-ethereum-rpc-url
POLYGON_RPC_URL=your-polygon-rpc-url
ENABLE_NFT_CERTIFICATES=false

# IoT Integration (Future)
IOT_DEVICE_API_KEY=your-iot-api-key
ENABLE_SMART_GLASS_INTEGRATION=false
ENABLE_TEMPERATURE_MONITORING=false

# ============================================================================
# COMPLIANCE AND LEGAL
# ============================================================================

# Privacy
ENABLE_GDPR_COMPLIANCE=true
ENABLE_CCPA_COMPLIANCE=true
COOKIE_CONSENT_REQUIRED=true

# Age Verification
MINIMUM_AGE=18
ENABLE_AGE_VERIFICATION=true
AGE_VERIFICATION_SERVICE=your-age-verification-service

# Content Restrictions
ENABLE_ALCOHOL_WARNINGS=true
RESTRICT_CONTENT_BY_REGION=true

# ============================================================================
# NOTES
# ============================================================================

# 1. Never commit actual secrets to version control
# 2. Use different values for development, staging, and production
# 3. Rotate secrets regularly
# 4. Use environment-specific configuration files
# 5. Enable only the features you need to reduce attack surface
# 6. Monitor environment variable usage and access
# 7. Use secure secret management services in production
# 8. Validate all environment variables on application startup
# 9. Document any custom environment variables
# 10. Keep this file updated as new features are added
