{
  "extends": [
    "next/core-web-vitals"
  ],
  "rules": {
    // ===== DESIGN SYSTEM COMPLIANCE RULES =====

    // Prevent design system violations
    "no-restricted-syntax": [
      "error",
      // Disallow raw HTML form elements — enforce design-system Form components
      {
        "selector": "JSXOpeningElement[name.name='input']",
        "message": "Raw <input> is not allowed. Use our Form/Input components instead."
      },
      {
        "selector": "JSXOpeningElement[name.name='textarea']",
        "message": "Raw <textarea> is not allowed. Use our Form/Textarea components instead."
      },
      {
        "selector": "JSXOpeningElement[name.name='select']",
        "message": "Raw <select> is not allowed. Use our Select component instead."
      },
      // Disallow any inline style usage for maintainability and token adherence
      {
        "selector": "JSXAttribute[name.name='style']",
        "message": "Inline styles are not allowed. Use tokens, utility classes, or component props."
      },
      // Hardcoded hex colors
      {
        "selector": "Literal[value=/^#[0-9a-fA-F]{3,8}$/]",
        "message": "Hardcoded hex colors are not allowed. Use fx-* semantic tokens instead."
      },
      // Hardcoded RGB/RGBA/HSL/HSLA values in inline styles
      {
        "selector": "JSXAttribute[name.name='style'] Literal[value=/rgb\\(|rgba\\(|hsl\\(|hsla\\(/]",
        "message": "Hardcoded color functions are not allowed. Use fx-* semantic tokens instead."
      },
      // Non-semantic Tailwind color classes
      {
        "selector": "JSXAttribute[name.name='className'] Literal[value=/\\b(text|bg|border)-(red|green|blue|yellow|purple|pink|indigo|gray)-(50|100|200|300|400|500|600|700|800|900)\\b/]",
        "message": "Non-semantic Tailwind color classes are not allowed. Use fx-* semantic tokens instead."
      },
      // Legacy fw- classes
      {
        "selector": "JSXAttribute[name.name='className'] Literal[value=/\\bfw-[a-zA-Z-]+\\b/]",
        "message": "Legacy fw- classes are deprecated. Use fx-* semantic tokens instead."
      },
      // Performance: transition-all
      {
        "selector": "JSXAttribute[name.name='className'] Literal[value=/\\btransition-all\\b/]",
        "message": "transition-all is not allowed for performance reasons. Use specific transition properties instead."
      }
    ],

    "no-console": "off", // Allow console for debugging

    // ===== STYLING CONSISTENCY RULES =====

    // Temporarily disabled import order - will re-enable after Phase 3
    // "import/order": [
    //   "error",
    //   {
    //     "groups": [
    //       "builtin",
    //       "external",
    //       "internal",
    //       ["parent", "sibling"],
    //       "index"
    //     ],
    //     "pathGroups": [
    //       {
    //         "pattern": "@/**",
    //         "group": "internal"
    //       }
    //     ],
    //     "newlines-between": "always"
    //   }
    // ],

    // Prevent unescaped quotes in JSX
    "react/no-unescaped-entities": "error"
  },

  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.test.ts", "__tests__/**/*.ts"],
      "rules": {
        // Relax rules for test files
        "import/order": "off",
        "react/no-unescaped-entities": "off",
        "no-restricted-syntax": "off"
      }
    }
  ]
}
