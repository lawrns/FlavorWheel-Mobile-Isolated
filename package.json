{
  "name": "flavorwheel-mobile-isolated",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "export": "next export",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run --reporter=verbose __tests__/unit",
    "test:unit:watch": "vitest --watch __tests__/unit",
    "test:integration": "vitest --run --reporter=verbose __tests__/integration",
    "test:component": "vitest --run --reporter=verbose __tests__/component",
    "test:services": "vitest --run --reporter=verbose __tests__/services",
    "test:hooks": "vitest --run --reporter=verbose __tests__/hooks",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:visual": "playwright test __tests__/visual",
    "test:accessibility": "playwright test __tests__/accessibility",
    "test:performance": "playwright test __tests__/performance",
    "test:styling": "playwright test styling-systematization.spec.ts",
    "test:load": "k6 run __tests__/load/load-test.js",
    "test:load:stress": "k6 run __tests__/load/stress-test.js",
    "test:security": "npm run test:security:auth && npm run test:security:xss && npm run test:security:csrf",
    "test:security:auth": "vitest --run __tests__/security/auth",
    "test:security:xss": "vitest --run __tests__/security/xss",
    "test:security:csrf": "vitest --run __tests__/security/csrf",
    "lighthouse": "lhci autorun",
    "lighthouse:mobile": "lhci autorun --config=mobileConfig",
    "coverage:report": "vitest --coverage --reporter=json --outputFile=coverage/coverage.json",
    "coverage:badge": "coverage-badge-creator",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "cross-env ANALYZE=true next build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install",
    "postinstall": "npm run db:generate-types || true",
    "db:generate-types": "supabase gen types typescript --local > types/supabase.ts",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "db:backup": "pg_dump $DATABASE_URL > backups/backup-$(date +%Y%m%d-%H%M%S).sql",
    "db:schema-update": "psql $DATABASE_URL -f database/migrations/001_comprehensive_schema_update.sql",
    "clean": "rm -rf .next dist coverage test-results playwright-report",
    "clean:all": "rm -rf .next dist coverage node_modules test-results playwright-report .nyc_output",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "security:scan": "npm run security:audit && npm run test:security",
    "docker:build": "docker build -t flavorwheel-mexico .",
    "docker:run": "docker run -p 3000:3000 flavorwheel-mexico",
    "docker:compose:up": "docker-compose -f deployment/docker-compose.yml up",
    "docker:compose:down": "docker-compose -f deployment/docker-compose.yml down",
    "lint:css": "stylelint '**/*.{css,scss}'",
    "lint:all": "npm run lint && npm run lint:css",
    "ci:quality": "npm run lint:all && npm run test:styling && npm run lighthouse",
    "test:intelligent": "node scripts/smart-test-runner.js"
  },
  "dependencies": {
    "@playwright/test": "^1.55.0",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.38.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.16.4",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.294.0",
    "next": "14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.13.0",
    "@stylelint/postcss-css-in-js": "^0.38.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "coverage-badge-creator": "^1.0.21",
    "cross-env": "^10.0.0",
    "cypress": "^15.1.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.0.4",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lighthouse": "^11.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-tailwindcss": "^0.0.7",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
