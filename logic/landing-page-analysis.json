      },
      "purpose": "Full-screen SVG background with aroma gradients",
      "styling": {
        "position": "absolute",
        "inset": "0",
        "width": "100%",
        "height": "100%",
        "objectFit": "cover",
        "pointerEvents": "none",
        "userSelect": "none"
