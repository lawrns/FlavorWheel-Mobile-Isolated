      "signature": "export default function LandingPage()",
      "parameters": "None - Pure presentational component",
      "return_type": "JSX.Element"
    },

    "helper_functions": {
      "handleIconClick": {
        "signature": "const handleIconClick = (route: string) => void",
        "purpose": "Centralized navigation handler for icon grid",
        "parameters": "route: string - Next.js route path",
        "logic": "router.push(route) - Client-side navigation"
      }
    }
  },

  "dom_structure": {
