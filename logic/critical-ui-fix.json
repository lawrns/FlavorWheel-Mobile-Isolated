  "component_hierarchy": {
    "root_container": {
      "element": "div",
      "purpose": "Main page wrapper with background and overflow handling",
      "styling": {
        "classes": ["overflow-x-hidden", "relative"],
        "inline_styles": {
          "webkitOverflowScrolling": "touch",
          "overscrollBehavior": "none",
          "backgroundImage": "url(/images/JPEG BG TRY.jpeg)",
          "backgroundSize": "cover",
          "backgroundPosition": "center",
          "backgroundRepeat": "no-repeat",
          "minHeight": "100vh"
        },
        "critical_notes": "Background image must be available at /public/images/JPEG BG TRY.jpeg"
      },
      "child_components": ["BackgroundOverlay", "MainContent"]
    },

    "background_overlay": {
      "element": "div",
      "purpose": "Semi-transparent gradient overlay for text readability",
      "styling": {
        "classes": ["absolute", "inset-0", "bg-gradient-to-b", "from-black/30", "via-black/20", "to-black/40"],
        "positioning": "absolute positioned overlay covering entire container"
      }
    },

    "main_content": {
      "element": "motion.main",
      "purpose": "Animated main content container with responsive layout",
      "styling": {
        "classes": ["relative", "z-10", "px-6", "py-12", "max-w-[768px]", "mx-auto", "min-h-screen"],
        "responsive_notes": "Fixed max-width ensures consistent layout on large screens"
      },
      "animation_config": {
        "framer_motion_props": {
          "initial": "hidden",
          "animate": "visible",
          "variants": "containerVariants"
        }
      },
      "child_sections": ["HeroSection", "FeatureCards", "StatisticsSection", "CallToActionSection"]
    },

    "hero_section": {
      "element": "motion.section",
      "purpose": "Main headline and tagline with staggered animations",
      "styling": {
        "classes": ["text-center", "mb-16"],
        "layout": "Centered text block with bottom margin"
      },
      "components": {
        "title": {
          "element": "motion.h1",
          "text_content": "Discover the Art of\\n<span>Flavor Exploration</span>",
          "styling": {
            "classes": ["text-4xl", "sm:text-5xl", "lg:text-6xl", "font-bold", "text-white", "mb-6", "font-heading", "tracking-tight", "drop-shadow-lg"],
            "inline_font": "fontFamily: \"'Playfair Display', ui-serif, Georgia, serif\"",
            "responsive_breakpoints": {
              "mobile": "text-4xl",
              "small": "text-5xl",
              "large": "text-6xl"
            }
          },
          "animation": {
            "initial": "{ opacity: 0, y: -30 }",
            "animate": "{ opacity: 1, y: 0 }",
            "transition": "{ duration: 0.8, delay: 0.2 }"
          }
        },
        "subtitle": {
          "element": "motion.p",
          "text_content": "The world's most user-friendly tasting experience. Create, explore, and share your flavor journey with confidence.",
          "styling": {
            "classes": ["text-xl", "text-white/90", "font-body", "max-w-2xl", "mx-auto", "leading-relaxed", "drop-shadow-md"],
            "responsive_notes": "Max-width constrains line length for readability"
          },
          "animation": {
            "initial": "{ opacity: 0 }",
            "animate": "{ opacity: 1 }",
            "transition": "{ duration: 0.8, delay: 0.4 }"
          }
        }
      }
    },

    "feature_cards": {
