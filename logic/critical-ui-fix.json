          }
        ]
      },
      "card_structure": {
        "element": "motion.button",
        "base_classes": ["bg-gradient-to-br", "backdrop-blur-sm", "border", "rounded-xl", "p-6", "text-left", "hover:shadow-xl", "hover:shadow-black/20", "transition-all", "duration-300", "group", "overflow-hidden"],
        "dynamic_classes": ["${feature.color}", "${feature.borderColor}"],
        "animation": {
          "variants": "itemVariants",
          "whileHover": "{ scale: 1.05, y: -5 }",
          "whileTap": "{ scale: 0.95 }",
          "transition_delay": "0.6 + index * 0.1"
        },
        "components": {
          "background_glow": {
            "element": "div",
