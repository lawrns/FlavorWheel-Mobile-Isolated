{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-tailwindcss"
  ],
  "rules": {
    "color-no-hex": [true, {
      "severity": "warning",
      "message": "Hardcoded hex colors are deprecated. Use fx- design tokens instead."
    }],
    "selector-max-compound-selectors": 3,
    "selector-max-specificity": "0,3,1"
  },
  "ignoreFiles": [
    "**/*.js",
    "**/*.ts",
    "**/*.tsx",
    "**/node_modules/**",
    "**/build/**",
    "**/.next/**"
  ]
}
