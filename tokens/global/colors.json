{
  "schema": "flavorwheel.design_system.colors.v1",
  "metadata": {
    "title": "FlavorWheel Global Color System",
    "version": "1.0.0",
    "created": "2025-09-14",
    "purpose": "Define core brand, surface, semantic, and accessibility colors for FlavorWheel mobile app",
    "scope": "All color tokens used across the application",
    "single_source_of_truth": true
  },

  "brand_colors": {
    "primary": {
      "value": "#2E7D32",
      "name": "Agave Verde",
      "usage": "Primary actions, CTAs, brand identity",
      "inspiration": "Mexican mezcal heritage, sustainable agave fields",
      "contrast_white": "5.2:1 ✓ WCAG AA",
      "contrast_black": "8.7:1 ✓ WCAG AAA"
    },
    "secondary": {
      "value": "#D4AF37",
      "name": "Oro Mexicano",
      "usage": "Secondary actions, premium elements, certifications",
      "inspiration": "Mexican gold mining heritage, tequila aging barrels",
      "contrast_white": "4.8:1 ✓ WCAG AA",
      "contrast_black": "12.3:1 ✓ WCAG AAA"
    },
    "accent": {
      "value": "#8B4513",
      "name": "Tierra Mexicana",
      "usage": "Contextual actions, flavor wheel segments, cultural elements",
      "inspiration": "Mexican volcanic soil, artisanal mezcal tradition",
      "contrast_white": "9.1:1 ✓ WCAG AAA",
      "contrast_black": "2.8:1 ⚠️ Use on dark backgrounds only"
    }
  },

