{
  "schema": "flavorwheel.design_system.theme.high_contrast.v1",
  "metadata": {
    "title": "FlavorWheel High Contrast Theme",
    "version": "1.0.0",
    "created": "2025-09-14",
    "purpose": "High contrast theme overrides for FlavorWheel mobile app accessibility",
    "scope": "Maximum contrast adjustments for users with visual impairments",
    "single_source_of_truth": true,
    "extends": "global/colors.json"
  },

  "color_overrides": {
    "background": {
      "app": "#FFFFFF",
      "surface_primary": "#FFFFFF",
      "surface_secondary": "#F8F8F8",
      "surface_dark": "#000000"
    },
    "text": {
      "primary": "#000000",
      "secondary": "#333333",
      "tertiary": "#666666",
      "inverse": "#FFFFFF"
    },
    "border": {
      "default": "#000000",
      "subtle": "#666666",
      "strong": "#000000",
      "focus": "#0066CC"
    },
    "shadows": {
      "level_1": "0 2px 4px rgba(0,0,0,0.8)",
      "level_2": "0 4px 8px rgba(0,0,0,0.9)",
      "level_3": "0 8px 16px rgba(0,0,0,0.95)",
      "level_4": "0 12px 24px rgba(0,0,0,1.0)"
    }
  },

  "brand_color_adjustments": {
    "primary": "#006600",
    "secondary": "#996600",
    "accent": "#660066",
    "success": "#006600",
    "warning": "#996600",
    "error": "#990000"
  },

  "accessibility_enhancements": {
    "border_thickness": "2px minimum",
    "focus_indicators": "3px solid #0066CC with 2px offset",
    "text_stroke": "1px solid contrasting color",
    "icon_enhancement": "Bold outlines and increased size",
    "spacing_increase": "1.5x normal spacing for better separation"
  },

  "component_specific": {
    "buttons": {
      "border": "2px solid #000000",
      "focus_ring": "3px solid #0066CC",
      "text_weight": "700 (bold)"
    },
    "inputs": {
      "border": "2px solid #000000",
      "focus_border": "3px solid #0066CC",
      "background": "#FFFFFF",
      "text": "#000000"
    },
    "cards": {
      "border": "2px solid #000000",
      "shadow": "0 2px 8px rgba(0,0,0,0.8)"
    }
  },

  "accessibility_guarantees": {
    "contrast_ratio": "All text meets WCAG AAA (7:1 minimum)",
    "color_blind_safe": true,
    "keyboard_navigation": "Enhanced focus indicators",
    "screen_reader_optimized": "Maximum compatibility with assistive technologies",
    "motor_impairment_friendly": "Larger touch targets and clear visual hierarchy"
  }
}


