{
  "schema": "flavorwheel.design_system.form_system.v1",
  "metadata": {
    "title": "FlavorWheel Unified Form/Input System",
    "version": "1.0.0",
    "created": "2025-09-14",
    "purpose": "Define mobile-first, culturally authentic form and input components with consolidated tokens, accessibility, and haptics",
    "scope": "Inputs for tasting notes, flavor descriptors, onboarding, community interactions",
    "single_source_of_truth": true,
    "replaces": ["fx_tokens", "fw_tokens", "Tailwind form styles"]
  },

  "design_tokens": {
    "color": {
      "input_bg": "var(--fw-color-papel-artesanal)",
      "input_border": "rgba(0,0,0,0.12)",
      "input_focus_border": "var(--fw-color-agave-verde)",
      "input_text": "#121212",
      "input_placeholder": "#9E9E9E",
      "input_disabled_bg": "#F0F0F0",
      "input_disabled_text": "#BDBDBD",
      "label_text": "#5C5C5C",
      "error_border": "var(--fw-color-error)",
      "success_border": "var(--fw-color-success)"
    },
    "spacing": {
      "padding_y": "12px",
      "padding_x": "14px",
      "border_radius": "12px",
      "gap": "8px",
      "field_margin": "16px"
    },
    "typography": {
      "label": {
        "font_family": "Inter Variable",
        "weight": 500,
        "size": "14px",
        "line_height": 1.4
      },
      "input": {
        "font_family": "Inter Variable",
        "weight": 400,
        "size": "16px",
        "line_height": 1.5
      },
      "helper": {
        "font_family": "Inter Variable",
        "weight": 400,
        "size": "13px",
        "line_height": 1.3
      }
    },
    "motion": {
      "focus_ring": {
        "transition": "border-color 150ms ease, box-shadow 150ms ease",
        "shadow": "0 0 0 3px rgba(46,125,50,0.25)"
      },
      "error_shake": {
        "animation": "shake 300ms cubic-bezier(.36,.07,.19,.97) both",
        "haptic": "UIImpactFeedbackStyleHeavy"
      }
    },
    "haptics": {
      "input_focus": "UIImpactFeedbackStyleLight",
      "success": "UINotificationFeedbackTypeSuccess",
      "error": "UINotificationFeedbackTypeError"
    }
  },

  "input_variants": {
    "text": {
      "usage": "Flavor notes, freeform tasting inputs",
      "max_length": 280,
      "placeholder_style": "Muted, italicized"
    },
    "textarea": {
      "usage": "Detailed tasting reviews",
      "rows": 4,
      "autosize": true,
      "scrollbar": "hidden for mobile cleanliness"
    },
    "select": {
      "usage": "Predefined descriptors, categories",
      "style": "Bottom sheet selector (mobile-first)",
      "icon": "chevron-down"
    },
    "checkbox": {
      "usage": "Binary selections (certifications, yes/no questions)",
      "style": "Rounded, 24px min size",
      "checked_color": "var(--fw-color-agave-verde)"
    },
    "radio": {
      "usage": "Flavor intensity levels",
      "style": "Circular, large tap zones",
      "group_layout": "Horizontal for short lists, vertical for long"
    },
    "slider": {
      "usage": "Intensity sliders for sweetness, acidity, bitterness",
      "track_color": "var(--fw-color-surface-secondary)",
      "thumb_color": "var(--fw-color-agave-verde)",
      "haptic": "light tick on value change"
    }
  },

  "states": {
    "default": {
      "bg": "var(--fw-color-input-bg)",
      "border": "1px solid var(--fw-color-input-border)"
    },
    "focused": {
      "border": "2px solid var(--fw-color-input-focus-border)",
      "motion": "focus_ring",
      "haptic": "input_focus"
    },
    "disabled": {
      "bg": "var(--fw-color-input-disabled-bg)",
      "text": "var(--fw-color-input-disabled-text)",
      "cursor": "not-allowed"
    },
    "error": {
      "border": "2px solid var(--fw-color-error)",
      "motion": "error_shake",
      "helper_text": "Error message displayed below input"
    },
    "success": {
      "border": "2px solid var(--fw-color-success)",
      "haptic": "success",
      "helper_text": "Confirmation text"
    }
  },

  "accessibility": {
    "contrast": "All text and placeholder >= 4.5:1",
    "touch_target": "≥44px for checkboxes, radios, sliders",
    "labels": "All inputs require visible and programmatic labels",
    "error_handling": "Errors announced via aria-live",
    "helper_text": "Screen reader-friendly descriptions for tasting guidance",
    "voice_input": "Supported for text/textarea fields",
    "gesture_support": "Sliders optimized for one-hand thumb gestures"
  },

  "implementation_notes": {
    "consolidation": "All form tokens live in `tokens/form.json`, no duplication",
    "react_components": [
      "<TextField />",
      "<Textarea />",
      "<Select />",
      "<Checkbox />",
      "<RadioGroup />",
      "<Slider />"
    ],
    "validation": "Real-time feedback with haptics and helper text",
    "offline_support": "Inputs cache locally, sync when online",
    "i18n": "Spanish-first with English fallback, indigenous terms respected"
  },

  "success_metrics": {
    "usability": "95%+ form completion rate on mobile",
    "contrast": "100% WCAG AA compliance for labels and placeholders",
    "performance": "No input >100ms render delay",
    "haptic_feedback": "Integrated in all focus, success, and error states",
    "cultural_fit": "Descriptors and guidance reflect Mexican beverage traditions"
  }
}


