{
  "schema": "flavorwheel.design_system.flavor_wheel.v1",
  "metadata": {
    "title": "FlavorWheel Unified Component System",
    "version": "1.0.0",
    "created": "2025-09-14",
    "purpose": "Define interactive flavor wheel component with unified tokens, mobile-first design, accessibility, and cultural authenticity",
    "scope": "Core visualization for tasting sessions on mobile",
    "single_source_of_truth": true,
    "replaces": ["fx_tokens", "fw_tokens", "Tailwind wheel styles"]
  },

  "design_tokens": {
    "layout": {
      "min_size": "320px",
      "max_size": "100vw",
      "padding": "16px",
      "safe_area": "env(safe-area-inset-bottom)"
    },
    "color": {
      "segment_palette": {
        "fruity": "#E4572E",
        "floral": "#E9A2AD",
        "vegetal": "#57A773",
        "smoky": "#6B5B95",
        "sweet": "#DFAF2B",
        "spicy": "#B53F3F",
        "bitter": "#2F4858",
        "sour": "#3B9ED8",
        "roasted": "#8C5A3A",
        "nutty": "#C29F6D",
        "mineral": "#7A8A8C",
        "earthy": "#6D7F4B",
        "woody": "#8D6E63"
      },
      "background": "#FEFCF8",
      "border": "#E0E0E0",
      "active_highlight": "var(--fw-color-agave-verde)",
      "inactive_opacity": 0.6
    },
    "typography": {
      "segment_label": {
        "font_family": "Inter Variable",
        "weight": 500,
        "size": "clamp(12px, 2vw, 14px)",
        "line_height": 1.2
      },
      "center_label": {
        "font_family": "Crimson Text Variable",
        "weight": 600,
        "size": "clamp(18px, 4vw, 22px)",
        "line_height": 1.3
      }
    },
    "motion": {
      "spin": {
        "animation": "cubic-bezier(0.34,1.56,0.64,1)",
        "duration": "350ms",
        "easing": "spring-like"
      },
      "zoom": {
        "transition": "transform 200ms ease-in-out",
        "scale_range": "0.8–1.5"
      },
      "selection": {
        "highlight": "scale(1.05)",
        "duration": "180ms",
        "haptic": "UIImpactFeedbackStyleLight"
      }
    }
  },

  "interaction_patterns": {
    "gestures": {
      "rotate": "Drag to rotate the wheel",
      "zoom": "Pinch to zoom in/out",
      "select": "Tap on segment",
      "reset": "Double-tap to reset orientation"
    },
    "feedback": {
      "haptic": {
        "on_select": "light_tap",
        "on_rotate": "subtle vibration every 45° snap",
        "on_zoom": "continuous soft feedback"
      },
      "visual": {
        "selected_segment": "Highlighted border + center label",
        "inactive_segments": "Dimmed to 60% opacity"
      }
    },
    "multi_modal": {
      "screen_reader": "Announces segment name + description in Spanish and English",
      "voice_input": "User can say flavor name to auto-select",
      "caption_support": "Descriptors appear below the wheel"
    }
  },

  "states": {
    "default": {
      "segments": "All visible, active",
      "center": "FlavorWheel title or tasting context"
    },
    "selected": {
      "highlight": "var(--fw-color-active-highlight)",
      "scale": 1.05,
      "aria_state": "aria-selected=true",
      "haptic": "on_select"
    },
    "inactive": {
      "opacity": "0.6",
      "aria_state": "aria-selected=false"
    },
    "loading": {
      "spinner_center": true,
      "aria_state": "aria-busy=true"
    }
  },

  "accessibility": {
    "contrast": "All segment colors >= 4.5:1 against background",
    "touch_target": "≥44px for each segment",
    "screen_reader": "Announces category and descriptor",
    "cultural_terms": "Spanish-first with English fallback",
    "color_blind_safe": true,
    "reduced_motion": "Animations replaced with opacity/haptic cues"
  },

  "implementation_notes": {
    "consolidation": "All wheel tokens live in `tokens/wheel.json`",
    "rendering": "Responsive SVG, scales to viewport width, capped at 100%",
    "performance": "GPU transforms only, lazy-load labels at zoom",
    "react_component": "<FlavorWheel /> with props: data, onSelect, interactive",
    "offline_support": "Wheel usable offline, selections cached locally"
  },

  "success_metrics": {
    "usability": "95%+ successful segment selection on mobile",
    "performance": "Spin/zoom/render at 60fps",
    "accessibility": "100% WCAG AA compliance, full screen reader support",
    "cultural_fit": "85%+ users recognize Mexican beverage authenticity",
    "single_source": "No duplicate wheel palettes or styles in codebase"
  }
}


