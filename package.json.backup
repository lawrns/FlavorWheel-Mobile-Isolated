{
  "name": "flavorwheel-mobile-isolated",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated mobile build of FlavorWheel - World's most user-friendly tasting experience",
  "homepage": "https://flavorwheel-mobile.netlify.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/lawrns/FlavorWheel-Mobile-Isolated.git"
  }
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "export": "next export",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run --reporter=verbose __tests__/unit",
    "test:unit:watch": "vitest --watch __tests__/unit",
    "test:integration": "vitest --run --reporter=verbose __tests__/integration",
    "test:component": "vitest --run --reporter=verbose __tests__/component",
    "test:services": "vitest --run --reporter=verbose __tests__/services",
    "test:hooks": "vitest --run --reporter=verbose __tests__/hooks",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:visual": "playwright test __tests__/visual",
    "test:accessibility": "playwright test __tests__/accessibility",
    "test:performance": "playwright test __tests__/performance",
    "test:load": "k6 run __tests__/load/load-test.js",
    "test:load:stress": "k6 run __tests__/load/stress-test.js",
    "test:security": "npm run test:security:auth && npm run test:security:xss && npm run test:security:csrf",
    "test:security:auth": "vitest --run __tests__/security/auth",
    "test:security:xss": "vitest --run __tests__/security/xss",
    "test:security:csrf": "vitest --run __tests__/security/csrf",
    "test:lighthouse": "lhci autorun",
    "test:storybook": "test-storybook",
    "test:all": "npm run type-check && npm run lint && npm run test:unit && npm run test:integration && npm run test:component && npm run test:services && npm run test:hooks && npm run test:e2e",
    "test:ci": "npm run test:all && npm run test:performance && npm run test:accessibility && npm run test:security",
    "coverage:report": "vitest --coverage --reporter=json --outputFile=coverage/coverage.json",
    "coverage:badge": "coverage-badge-creator",
    "db:generate-types": "supabase gen types typescript --local > types/supabase.ts",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "db:backup": "pg_dump $DATABASE_URL > backups/backup-$(date +%Y%m%d-%H%M%S).sql",
    "db:schema-update": "psql $DATABASE_URL -f database/migrations/001_comprehensive_schema_update.sql",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:link": "supabase link",
    "deploy:dev": "./scripts/deploy.sh development",
    "deploy:staging": "./scripts/deploy.sh staging",
    "deploy:prod": "./scripts/deploy.sh production",
    "deploy:prod:skip-tests": "./scripts/deploy.sh production true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "cross-env ANALYZE=true next build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install",
    "postinstall": "npm run db:generate-types || true",
    "clean": "rm -rf .next dist coverage test-results playwright-report",
    "clean:all": "rm -rf .next dist coverage node_modules test-results playwright-report .nyc_output",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "security:scan": "npm run security:audit && npm run test:security",
    "docker:build": "docker build -t flavorwheel-mexico .",
    "docker:run": "docker run -p 3000:3000 flavorwheel-mexico",
    "docker:compose:up": "docker-compose -f deployment/docker-compose.yml up",
    "docker:compose:down": "docker-compose -f deployment/docker-compose.yml down"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@supabase/supabase-js": "^2.56.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.454.0",
    "next": "15.2.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-icons": "^5.5.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^18.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.7",
    "autoprefixer": "^10.4.20",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.2",
    "husky": "^9.1.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",

    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/cypress": "^10.0.1",

    "vitest": "^1.3.1",
    "@vitest/ui": "^1.3.1",
    "@vitest/coverage-v8": "^1.3.1",
    "jsdom": "^23.2.0",

    "@playwright/test": "^1.40.1",
    "@axe-core/playwright": "^4.8.5",
    "playwright-visual-regression": "^0.1.0",

    "msw": "^2.2.13",

    "@lhci/cli": "^0.13.0",

    "k6": "^0.49.0",

    "@storybook/test-runner": "^0.16.0",
    "@storybook/testing-react": "^2.0.1",

    "coverage-badge-creator": "^1.2.1",

    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@types/jest": "^29.5.8",

    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "lint-staged": "^15.2.0",
    "cross-env": "^7.0.3",
    "@next/bundle-analyzer": "^14.0.4",
    "supabase": "^1.123.4",

    "axe-core": "^4.9.1",
    "pa11y": "^6.2.3",
    "lighthouse": "^11.4.0",

    "cypress": "^13.6.4",
    "cypress-axe": "^1.5.0",
    "cypress-real-events": "^1.12.0",

    "testcafe": "^3.5.0",

    "@wdio/mocha-framework": "^8.29.3",
    "@wdio/spec-reporter": "^1.0.0",

    "selenium-webdriver": "^4.15.0",

    "puppeteer": "^21.6.1",

    "chromedriver": "^120.0.0",

    "supertest": "^6.3.4",
    "nock": "^13.5.4",

    "faker": "^6.6.6",
    "chance": "^1.1.11",

    "sinon": "^17.0.1",
    "proxyquire": "^2.1.3",

    "mutation-testing-elements": "^3.0.4",
    "stryker": "^0.35.1",

    "allure-playwright": "^2.9.2",
    "allure-vitest": "^1.0.0",

    "cucumber": "^9.4.0",

    "docker-compose": "^0.24.0",

    "pm2": "^5.3.0",

    "newman": "^6.1.3",

    "artillery": "^2.0.8",

    "vegeta": "^12.8.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },

}
